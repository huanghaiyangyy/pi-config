{
  "lastChangelogVersion": "0.84.4",
  "theme": "catppuccin-mocha",
  "defaultProvider": "antigravity",
  "defaultModel": "gemini-3.8-flash",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 12000
  },
  "enableSkillCommands": false,
  "tuiMode": "regular",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-open-tui",
    "npm:pi-subagents",
    "npm:@narumitw/pi-btw",
    "git:github.com/algal/pi-openai-server-compaction",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-antigravity",
    "npm:@heathhe/pi-agent-notify"
  ],
  "subagents": {
    "defaultModel": "pingstream/gpt-5.6-luna",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "pingstream/gpt-5.6-luna",
        "thinking": "low"
      },
      "worker": {
        "model": "pingstream/gpt-5.6-luna",
        "thinking": "high"
      },
      "reviewer": {
        "model": "pingstream/gpt-5.6-luna",
        "thinking": "high"
      },
      "oracle": {
        "model": "pingstream/gpt-5.6-sol",
        "thinking": "high"
      }
    }
  }
}